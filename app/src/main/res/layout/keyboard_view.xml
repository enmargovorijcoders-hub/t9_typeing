<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0D1A12"
    android:padding="6dp">

    <TextView
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="5dp"
        android:text="abc  •  ready"
        android:textColor="#81C784"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Row 1: 1, 2, 3, DEL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_num_bg"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="1\n.,?!" />

        <Button
            android:id="@+id/key_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_num_bg"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="2\nabc" />

        <Button
            android:id="@+id/key_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_num_bg"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="3\ndef" />

        <Button
            android:id="@+id/key_del"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_margin="3dp"
            android:background="@drawable/key_action_bg"
            android:textColor="#C8E6C9"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:text="DEL" />
    </LinearLayout>

    <!-- Row 2: 4, 5, 6, Case -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_num_bg"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="4\nghi" />

        <Button
            android:id="@+id/key_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_num_bg"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="5\njkl" />

        <Button
            android:id="@+id/key_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_num_bg"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="6\nmno" />

        <Button
            android:id="@+id/key_case"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_margin="3dp"
            android:background="@drawable/key_action_bg"
            android:textColor="#A5D6A7"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:text="abc" />
    </LinearLayout>

    <!-- Row 3: 7, 8, 9, Enter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_num_bg"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="7\npqrs" />

        <Button
            android:id="@+id/key_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_num_bg"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="8\ntuv" />

        <Button
            android:id="@+id/key_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_num_bg"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="9\nwxyz" />

        <Button
            android:id="@+id/key_enter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_margin="3dp"
            android:background="@drawable/key_enter_bg"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:text="OK" />
    </LinearLayout>

    <!-- Row 4: *, 0 (Space), #, Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_star"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_num_bg"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="*\n+ - @" />

        <Button
            android:id="@+id/key_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_num_bg"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="0\nSPACE" />

        <Button
            android:id="@+id/key_hash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_num_bg"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:text="#\n123" />

        <Button
            android:id="@+id/key_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_margin="3dp"
            android:background="@drawable/key_action_bg"
            android:textColor="#A5D6A7"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:text=">" />
    </LinearLayout>

</LinearLayout>
